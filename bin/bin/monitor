#!/bin/bash

# Configure displays for workstation or laptop.

set -euo pipefail

external_output=$(
  xrandr --query \
    | awk '/^(DP|HDMI)-[0-9]+ connected/ { print $1; exit }'
)

if [ -n "${external_output}" ]; then
  if ! xrandr --output "${external_output}" --mode 3840x2160 --rate 60 --scale 0.75x0.75; then
    xrandr --output "${external_output}" --auto
  fi
fi

if xrandr --query | awk '/^eDP-1 connected/ { found = 1 } END { exit !found }'; then
  xrandr --output eDP-1 --mode 1920x1080
fi
