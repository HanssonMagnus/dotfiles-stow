# i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
# Change $SCRIPT_DIR to the location of your scripts!
#command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=15
markup=none

# Key layout
[key_layout]
command=~/.config/i3blocks/my_blocks/keyboard_layout/keyboard_layout
label=⌨️
interval=30

# Volume
[volume]
command=~/.config/i3blocks/my_blocks/volume/volume
min_width=🔊 100%
interval=once
signal=10

# Volume
#[volume-pulseaudio]
#command=~/.config/i3blocks/volume-pulseaudio/volume-pulseaudio
#interval=persist
#SUBSCRIBE=1
#USE_ALSA_NAME=1
#
## Memory usage
[memory]
command=~/.config/i3blocks/my_blocks/memory/memory
label=🐏
separator=false
interval=30
#
## Disk usage
##
## The directory defaults to $HOME if the instance is not specified.
## The script may be called with a optional argument to set the alert
## (defaults to 10 for 10%).
[disk]
#command=$SCRIPT_DIR/disk
command=~/.config/i3blocks/my_blocks/disk/disk
label=🏠
#DIR=/mnt/data
interval=30
#
## Temperature
[temperature]
command=~/.config/i3blocks/my_blocks/temperature/temperature
label=🌡️
interval=10
#
## CPU usage
##
## The script may be called with -w and -c switches to specify thresholds,
## see the script for details.
[cpu_usage]
command=~/.config/i3blocks/my_blocks/cpu_usage/cpu_usage
label=🧠
interval=10
min_width=🧠 100.00%
##separator=false
#
## Battery indicator
##
## The battery instance defaults to 0.
[battery]
command=~/.config/i3blocks/my_blocks/battery/battery
label=BAT
label=⚡
interval=30
#
## Arch updates
##[arch-update]
##command=~/.config/i3blocks/arch-update/arch-update
##interval=3600
##markup=pango
##LABEL=Updates:
#
## Nosleep — toggle system sleep/idle prevention
[nosleep]
command=~/.config/i3blocks/my_blocks/nosleep/nosleep
interval=once
signal=11

## ProtonVPN — toggle VPN connection, shows connected server
[protonvpn]
command=~/.config/i3blocks/my_blocks/protonvpn/protonvpn
interval=3
signal=12

## Redshift — toggle night-vision color temperature, scroll to adjust warmth
[redshift]
command=~/.config/i3blocks/my_blocks/redshift/redshift
interval=once
signal=13

## Dunst — toggle do-not-disturb (mute/unmute all notifications)
[dunst]
command=~/.config/i3blocks/my_blocks/dunst/dunst
interval=once
signal=14

## Date Time
##
[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1

## Spacer — keeps [time] from being the last block so i3bar draws the clock's
## normal right-hand separator (matching the faint dividers between blocks).
## Prints a zero-width space (U+200B). Octal escape, not \x: i3blocks runs
## commands via dash, whose printf supports \nnn octal but not \x hex.
[edge_sep]
command=printf '\342\200\213'
interval=once
separator=false
separator_block_width=0
